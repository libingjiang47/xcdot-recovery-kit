{
  "name": "xcdot-recovery-kit",
  "version": "0.26.0",
  "description": "Independent, reproducible xcDOT state extraction and verification tooling.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "xcdot-recovery": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli/index.js",
    "build:snapshot": "node dist/cli/index.js build-release",
    "capture:proofs": "node dist/cli/index.js capture-release-proofs --data data --resume",
    "verify:release": "NO_NETWORK=1 node dist/cli/index.js verify-release --data data",
    "web:build": "node scripts/build-web-data.mjs"
  },
  "dependencies": {
    "@polkadot/api": "16.4.4",
    "@polkadot/rpc-provider": "16.4.4",
    "@polkadot/util": "13.5.5",
    "@polkadot/util-crypto": "13.5.5",
    "commander": "14.0.0",
    "viem": "2.31.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "24.0.0",
    "eslint": "9.31.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4"
  }
}
